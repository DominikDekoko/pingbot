# BotFather → /newbot
BOT_TOKEN=
# https://my.telegram.org → API development tools (нужны даже боту)
API_ID=
API_HASH=

# Администраторы бота: личные Telegram ID через запятую. Пусто — админов нет.
# Пример: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Общий секрет бота и Flowseal: 32 hex-символа БЕЗ dd/ee.
# Сгенерировать: python3 -c 'import secrets; print(secrets.token_hex(16))'
TG_WS_PROXY_SECRET=
TG_WS_PROXY_HOST=tg-ws-proxy
TG_WS_PROXY_PORT=1443
# Настройка Flowseal по умолчанию; при необходимости измените адреса DC.
TG_WS_PROXY_DC_IPS="2:149.154.167.220 4:149.154.167.220"

# True: @all могут вызывать все; False: только администраторы чата.
ALL_ALLOW_EVERYONE=True
# Минимальный интервал между пингами в одном чате, секунды; 0 отключает.
PING_COOLDOWN_SECONDS=30
# Для запуска вне Docker; Compose использует /app/data и volume.
DATA_DIR=data
